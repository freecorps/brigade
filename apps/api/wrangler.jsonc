// The top-level config is production (`brigade-api`); `dev` and `staging` are the environments below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigade-api",
  "main": "./src/index.ts",
  // Matches the installed workerd so local and deployed behaviour agree.
  "compatibility_date": "2026-10-19",
  // No public workers.dev or preview URLs yet: auth exists, but `/workspaces/:id` is still an open dev
  // placeholder (src/index.ts). Both keys are inherited by environments.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  // ProbeDO: one per workspace and region, created with a `locationHint` (RFC 0007, src/probe.ts).
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "PROBE", "class_name": "ProbeDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ProbeDO"] },
  ],
  // Better Auth's tables (src/auth.ts); migrations/ holds their schema. No `database_id` for production and
  // staging yet: those databases do not exist, and the first deploy (owner approval) creates and pins them.
  "d1_databases": [
    { "binding": "DB", "database_name": "brigade-db", "migrations_dir": "migrations" },
  ],
  // Set with `wrangler secret put` (deployed) or apps/api/.dev.vars (local, gitignored); never in this file.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  // Durable Object, D1 and secrets settings are not inherited, so each environment repeats them.
  // No `vars` anywhere: no deployed environment may set SYNC_DEV_ACTOR (src/actor.ts); only local runs and the
  // tests do, in their Vite configs.
  "env": {
    "dev": {
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
          { "name": "PROBE", "class_name": "ProbeDO" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brigade-db-dev",
          "database_id": "97362d14-04ad-4204-a77c-4f488035db25",
          "migrations_dir": "migrations",
        },
      ],
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
    },
    "staging": {
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
          { "name": "PROBE", "class_name": "ProbeDO" },
        ],
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "brigade-db-staging", "migrations_dir": "migrations" },
      ],
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
    },
  },
}
