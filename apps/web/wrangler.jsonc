// The dashboard Worker: the SPA on static assets, plus /api/* forwarded to the API Worker.
// The top-level config is production (`brigade-web`); `dev` and `staging` are the environments below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigade-web",
  "main": "./worker/index.ts",
  // Same as apps/api: matches the installed workerd so local and deployed behaviour agree.
  "compatibility_date": "2026-10-19",
  // No public workers.dev or preview URLs for production or staging; only `dev` turns on its workers.dev URL (below),
  // for testing on a phone. Both keys are inherited by environments. Every API route behind /api/* checks its own
  // session or token (apps/api/src/index.ts).
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  // No `directory`: the Cloudflare Vite plugin fills it with the client build output.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls (worker/index.ts strips the prefix), /slack/* (the Slack app, RFC 0011, through the optional
    // SLACK binding) and /status/* (the public status page, RFC 0012, rendered by the API) reach the Worker;
    // everything else is an asset or index.html.
    "run_worker_first": ["/api", "/api/*", "/slack/*", "/status/*"],
  },
  // In `vp dev` the API Worker runs alongside as an auxiliary worker (vite.config.ts).
  "services": [{ "binding": "API", "service": "brigade-api" }],
  // Service bindings are not inherited, so each environment names its own API Worker.
  "env": {
    "dev": {
      // The dashboard at https://brigade-web-dev.<subdomain>.workers.dev (the subdomain names the account, so it is
      // never written here); the API stays private behind the `API` binding. Preview URLs stay off.
      "workers_dev": true,
      // No SLACK binding is committed: a service binding to a Worker that does not exist fails the deploy. Add
      // `{ "binding": "SLACK", "service": "brigade-slack-<env>" }` here with the Slack Worker's first deploy
      // (integrations/slack/README.md); without it /slack/* answers 404.
      "services": [{ "binding": "API", "service": "brigade-api-dev" }],
    },
    "staging": {
      "services": [{ "binding": "API", "service": "brigade-api-staging" }],
    },
  },
}
