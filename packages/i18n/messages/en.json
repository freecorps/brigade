{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_name": "Brigade",
  "app_tagline": "Open-source incident management that deploys to your Cloudflare account.",
  "theme_label": "Theme",
  "theme_light": "Light",
  "theme_dark": "Dark",
  "theme_system": "System",
  "language_label": "Language",
