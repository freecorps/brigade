// The top-level config is production (`brigade-api`); `dev` and `staging` are the environments below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigade-api",
  "main": "./src/index.ts",
  // Matches the installed workerd so local and deployed behaviour agree.
  "compatibility_date": "2026-10-19",
  // No public workers.dev or preview URLs in any environment: the API is reached only through the web Worker's `API`
  // service binding (apps/web), whose `dev` environment has the public workers.dev URL. Both keys are inherited by
  // environments.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  // ProbeDO: one per workspace and region, created with a `locationHint` (RFC 0007, src/probe.ts).
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "PROBE", "class_name": "ProbeDO" },
      // WatchdogDO: the one object behind the external dead-man switch (RFC 0007, src/watchdog.ts).
      { "name": "WATCHDOG", "class_name": "WatchdogDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ProbeDO"] },
    { "tag": "v3", "new_sqlite_classes": ["WatchdogDO"] },
  ],
  // The dead-man switch's clock: a heartbeat through the paging pipeline every minute (src/index.ts `scheduled`).
  // Inherited by the environments. Locally it never fires on its own: under `vp run dev` (the Vite plugin) run it with
  // POST /cdn-cgi/local/explorer/api/local/scheduled?worker=brigade-api (apps/api/README.md "Dead-man switch").
  "triggers": { "crons": ["* * * * *"] },
  // Better Auth's tables (src/auth.ts); migrations/ holds their schema. Production and staging databases exist with the
  // migrations applied (apps/api/README.md "D1").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brigade-db",
      "database_id": "5c4a8554-647b-45c7-9a3e-d1ba3b23ed79",
      "migrations_dir": "migrations",
    },
  ],
  // The outbox drain's Queue and its consumer (RFC 0005; src/outbox.ts, src/notify.ts). Pages are urgent, so a
  // batch waits at most 1 s. The consumer gives up on a page after 5 attempts (`MAX_PAGE_ATTEMPTS`) and records it
  // as failed; `max_retries` is above that (`QUEUE_MAX_RETRIES`) so the Queue never drops a page first. Whatever
  // still fails (the shard unreachable or throwing every time) lands in the dead-letter queue, which this Worker
  // also consumes: it records each page there on its incident's timeline once and acks, never retrying
  // (`consumeDeadLetters`). Production and staging queues do not exist yet: the first deploy (owner approval)
  // creates them with `wrangler queues create`.
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "brigade-events" }],
    "consumers": [
      {
        "queue": "brigade-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "brigade-events-dlq",
      },
      { "queue": "brigade-events-dlq", "max_batch_size": 10, "max_retries": 5 },
    ],
  },
  // Cloudflare Email Sending (RFC 0005 "Email", src/email.ts): the email notifier tells a member a page missed them and
  // the owners when nobody could be paged. No sender or destination restriction here: the sender is the secret
  // EMAIL_FROM, on a domain onboarded to Email Sending (apps/api/README.md "Email"), so no domain is in this file.
  // Without EMAIL_FROM nothing is sent. Locally the binding is simulated (logged, never sent): never `remote: true`.
  "send_email": [{ "name": "EMAIL" }],
  // Workers Rate Limiting (src/index.ts `receiptAllowed`): delivery receipts per workspace and caller address a minute,
  // checked before a receipt wakes its shard. A page is one receipt per phone, so 120 covers a large team behind one
  // address. Each environment has its own namespace so their counts never mix; locally it is simulated.
  // Alert sources (RFC 0005 "Alert sources", src/index.ts `receiveAlerts`), each a minute: ALERT_WORKSPACE_LIMIT,
  // payloads per workspace, checked before a payload wakes its shard, and only for a token the isolate has not seen
  // accepted lately, so a flood of wrong secrets cannot hold a sending source back; ALERT_LIMIT, payloads per source, checked by the
  // shard once the secrets matched (src/workspace.ts `alertAllowed`), so wrong secrets never spend it;
  // ALERT_REFUSED_LIMIT, refused requests per workspace, past which a token refused lately wakes no shard. Repeats are
  // deduplicated anyway; these bound the shard's work.
  // API_TOKEN_LIMIT (RFC 0014, src/api-tokens.ts): requests per API token a minute, counted once the token is valid.
  // The status page's subscribe form (src/status-subscribers.ts): 5 a minute per caller address and 30 a minute per
  // page, checked before D1 or a shard is touched. Namespace ids 416x and 417x, one per environment like the receipts'.
  // STATUS_MISS_LIMIT (src/status-route.ts): `/status/*` answers with no page there, 30 a minute per caller address,
  // then 429; a page that exists is never counted (RFC 0012 "Caching and abuse"). Namespace ids 418x.
  // STATUS_DOMAIN_LIMIT (src/status-domain.ts): changes to a status page's own domain, 10 a minute per workspace, each
  // a call to Cloudflare's API. Namespace ids 419x.
  "ratelimits": [
    { "name": "RECEIPT_LIMIT", "namespace_id": "4101", "simple": { "limit": 120, "period": 60 } },
    { "name": "ALERT_LIMIT", "namespace_id": "4111", "simple": { "limit": 300, "period": 60 } },
    {
      "name": "ALERT_WORKSPACE_LIMIT",
      "namespace_id": "4121",
      "simple": { "limit": 1200, "period": 60 },
    },
    {
      "name": "ALERT_REFUSED_LIMIT",
      "namespace_id": "4131",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "API_TOKEN_LIMIT",
      "namespace_id": "4141",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "STATUS_SUBSCRIBE_IP_LIMIT",
      "namespace_id": "4161",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "STATUS_SUBSCRIBE_PAGE_LIMIT",
      "namespace_id": "4171",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "STATUS_MISS_LIMIT",
      "namespace_id": "4181",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "STATUS_DOMAIN_LIMIT",
      "namespace_id": "4191",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // The public status page's snapshots (RFC 0012, src/status-page.ts): each workspace shard pushes its page here on
  // every change, and `GET /status/:slug` reads it, so no visitor ever wakes a shard. Without an `id` this binding is
  // for local runs and the tests only (Miniflare simulates it); `dev` binds `brigade-status-dev`. KV is unbound in
  // `staging` until a namespace exists (apps/api/README.md "Status page"), and the page then answers 404 while the
  // dashboard still sets it up.
  "kv_namespaces": [{ "binding": "STATUS" }],
  // Exports (RFC 0013, src/exports.ts): files owners and admins export, under `workspaces/<id>/`, never public, read
  // back through `GET /workspaces/:id/exports/:exportId`. Without a `bucket_name` this binding is for local runs and the
  // tests only (Miniflare simulates it). `dev` binds `brigade-exports-dev` and Workers AI (`AI`, postmortem drafts);
  // `staging` has neither until its bucket exists (apps/api/README.md "Exports"), and there exporting answers 503 and
  // the "Draft with AI" button is hidden.
  "r2_buckets": [{ "binding": "EXPORTS" }],
  // Set with `wrangler secret put` (deployed) or apps/api/.dev.vars (local, gitignored); never in this file.
  // RELAY_SEND_TOKEN (src/notify.ts) is optional: paging needs it and the relay, reached through the `RELAY` service
  // binding (per environment, below) or, unbound, at the RELAY_URL secret (a self-hosted instance using Freecorps'
  // hosted relay, RFC 0006). Without them every page is recorded as failed.
  // DEAD_MAN_URL (src/watchdog.ts) is optional too: the external check's ping URL; without it nothing is pinged.
  // OPERATOR_EMAILS (src/notify-operators.ts) is optional: comma-separated addresses emailed when the paging
  // self-check changes status (`brigade.status_changed`); without it (or without EMAIL_FROM) nobody is.
  // EMAIL_FROM and DASHBOARD_URL (src/email.ts, src/notify-email.ts) are optional: the sender of the email notifier
  // and the dashboard's origin for links in it; without EMAIL_FROM no email is sent.
  // SLACK_TOKEN_KEY (src/slack-token.ts) is optional: 32 random bytes, base64url, that seal Slack bot tokens at rest; without
  // it Slack is off (no install, no messages). The Slack Worker binds to this one's SlackBridge entrypoint (RFC 0011);
  // its D1 table is migrations/0006_slack_team.sql.
  // WEBHOOK_SECRET_KEY (src/webhook-routes.ts) is optional too: 32 random bytes, base64url, that seal webhook signing
  // secrets at rest; without it outbound webhooks are off (RFC 0005 "Outbound webhooks").
  // MAX_MONITORS (src/monitors.ts) is optional: the most monitors any workspace may have, 1 to 10000; without it 100.
  // Owners set a lower cap per workspace (`monitor.setCap`, RFC 0007 "Limits").
  // API_TOKEN_KEY (src/api-tokens.ts) is optional: 32 random bytes, base64url, the HMAC key API tokens are hashed under
  // (RFC 0014); without it they are hashed with SHA-256 alone. Setting it later keeps tokens (each row moves to the
  // keyed digest on its next use); changing or removing it invalidates every token hashed under it.
  // CF_SAAS_TOKEN, CF_ZONE_ID and CF_SAAS_FALLBACK_ORIGIN (src/status-domain.ts) are optional, all three or none:
  // custom domains for status pages through Cloudflare for SaaS (RFC 0012 "Custom domains", README "Custom domains").
  // The token is scoped to "SSL and Certificates: Edit" on that zone alone; the zone id and the fallback origin's
  // hostname (what owners point their CNAME at) are set like secrets so no account's ids are in this file. They also
  // need DASHBOARD_URL. Without them the dashboard hides the section and its routes answer 503 `not_configured`.
  // BOOTSTRAP_TOKEN (src/bootstrap.ts) is optional: at least 32 random characters, set only on a new instance until its
  // first owner exists (scripts/create-first-user.mjs, apps/api/README.md "First owner"); without it
  // `POST /setup/first-user` does not exist.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  // Durable Object, D1, Queue, email, rate limit, service, vars and secrets settings are not inherited, so each
  // environment repeats them.
  // SIGNUP (src/sign-up.ts) is who may create an account: `open`, `invite` or `closed`. Unset, as in production and
  // staging, it is `closed` (RFC 0002 "Sign-up modes"); only `dev` sets it, to `open`. Without an email sender it is
  // always `closed`. REQUIRE_VERIFIED_EMAIL (`true`) keeps unverified accounts from signing in; unset is off.
  // EMAIL_DAILY_CEILING (src/email-ceiling.ts) is the most emails a day from the whole instance; unset is 2000.
  // No other `vars`: no deployed environment may set SYNC_DEV_ACTOR (src/actor.ts); only local runs and the tests do,
  // in their Vite configs.
  "env": {
    "dev": {
      // Anyone may sign up on dev (RFC 0002 "Sign-up modes").
      "vars": { "SIGNUP": "open" },
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
          { "name": "PROBE", "class_name": "ProbeDO" },
          { "name": "WATCHDOG", "class_name": "WatchdogDO" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brigade-db-dev",
          "database_id": "97362d14-04ad-4204-a77c-4f488035db25",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "brigade-events-dev" }],
        "consumers": [
          {
            "queue": "brigade-events-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "dead_letter_queue": "brigade-events-dlq-dev",
          },
          { "queue": "brigade-events-dlq-dev", "max_batch_size": 10, "max_retries": 5 },
        ],
      },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        {
          "name": "RECEIPT_LIMIT",
          "namespace_id": "4103",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "ALERT_LIMIT",
          "namespace_id": "4113",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "ALERT_WORKSPACE_LIMIT",
          "namespace_id": "4123",
          "simple": { "limit": 1200, "period": 60 },
        },
        {
          "name": "ALERT_REFUSED_LIMIT",
          "namespace_id": "4133",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "API_TOKEN_LIMIT",
          "namespace_id": "4143",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "STATUS_SUBSCRIBE_IP_LIMIT",
          "namespace_id": "4163",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "STATUS_SUBSCRIBE_PAGE_LIMIT",
          "namespace_id": "4173",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "STATUS_MISS_LIMIT",
          "namespace_id": "4183",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "STATUS_DOMAIN_LIMIT",
          "namespace_id": "4193",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      // `brigade-status-dev`, the dev status page snapshots (RFC 0012).
      "kv_namespaces": [{ "binding": "STATUS", "id": "cc29234582db43538204e0ae375d8ec8" }],
      // `brigade-exports-dev` (8-day lifecycle rule on `workspaces/`) and Workers AI for postmortem drafts (RFC 0013).
      "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "brigade-exports-dev" }],
      "ai": { "binding": "AI" },
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
      // The relay on this account (apps/relay). A Worker's fetch to another workers.dev Worker on the same account is
      // answered 404, so the API reaches it through this binding and RELAY_URL is not used. Only `dev` has one: a
      // binding to a Worker that does not exist fails the deploy, so production and staging add theirs with their
      // relay's first deploy. Locally and in the tests it is unbound.
      "services": [{ "binding": "RELAY", "service": "brigade-relay-dev" }],
    },
    "staging": {
      "durable_objects": {
        "bindings": [
          { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
          { "name": "PROBE", "class_name": "ProbeDO" },
          { "name": "WATCHDOG", "class_name": "WatchdogDO" },
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brigade-db-staging",
          "database_id": "395f4384-29e7-4b20-8521-d0d0f3300beb",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "EVENTS", "queue": "brigade-events-staging" }],
        "consumers": [
          {
            "queue": "brigade-events-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 10,
            "dead_letter_queue": "brigade-events-dlq-staging",
          },
          { "queue": "brigade-events-dlq-staging", "max_batch_size": 10, "max_retries": 5 },
        ],
      },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        {
          "name": "RECEIPT_LIMIT",
          "namespace_id": "4102",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "ALERT_LIMIT",
          "namespace_id": "4112",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "ALERT_WORKSPACE_LIMIT",
          "namespace_id": "4122",
          "simple": { "limit": 1200, "period": 60 },
        },
        {
          "name": "ALERT_REFUSED_LIMIT",
          "namespace_id": "4132",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "API_TOKEN_LIMIT",
          "namespace_id": "4142",
          "simple": { "limit": 300, "period": 60 },
        },
        {
          "name": "STATUS_SUBSCRIBE_IP_LIMIT",
          "namespace_id": "4162",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "STATUS_SUBSCRIBE_PAGE_LIMIT",
          "namespace_id": "4172",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "STATUS_MISS_LIMIT",
          "namespace_id": "4182",
          "simple": { "limit": 30, "period": 60 },
        },
        {
          "name": "STATUS_DOMAIN_LIMIT",
          "namespace_id": "4192",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
    },
  },
}
