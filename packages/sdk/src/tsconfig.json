{
  // Runtime code: no Node types, so a Node-only API here fails the type check. WebCrypto and fetch come from the
  // `webworker` lib, the standard API Workers, browsers and Node share. No `@freecorps/source` condition: the
  // declarations bundled into dist come from the schema package's built ones (vite.config.ts).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "webworker"],
    "types": [],
    "customConditions": []
  },
  "include": ["."]
}
