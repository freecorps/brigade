// Spike S1 (RFC 0006). The top-level config is production (`brigade-relay`); `dev` is the environment below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigade-relay",
  "main": "./src/index.ts",
  // Matches the installed workerd so local and deployed behaviour agree.
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    // No traces: an outbound fetch span records the URL, and the APNs URL ends in the device token.
    "traces": { "enabled": false },
  },
  "upload_source_maps": true,
  // Production APNs; the app's build sets `aps-environment` to match. RELAY_TERMS_VERSION is the hosted relay's terms
  // version a registration must accept (RFC 0015, decision D5). The contact code's email is the `send_email` binding
  // `EMAIL` below and the secret `EMAIL_FROM` (relay@brigade.freecorps.com.br, a subdomain onboarded to Email Sending);
  // `env.dev` binds neither, so its `/v1/instances/contact` answers 503 (README "Instance registration"). A
  // company's own relay keeps these vars: `vp run setup:relay` sets its topic and closed registration as the secrets
  // `RELAY_APNS_TOPIC` (which wins over `APNS_TOPIC`) and `RELAY_CLOSED=1`, kept by every deploy (README "Closed
  // registration"). Never add a var with either name: a secret may not share a var's name. The hosted relay's Custom Domain (relay.brigade.freecorps.com.br) is attached in the dashboard,
  // not here, so a deploy creates no route.
  "vars": {
    "APNS_ENVIRONMENT": "production",
    "APNS_TOPIC": "app.freecorps.brigade",
    "RELAY_TERMS_VERSION": "draft-2026-11",
  },
  // The instance registry (RFC 0015, src/registry.ts): one object per instance and per contact address. The deploy
  // creates the class; nothing to set up by hand. Not inherited by `env.dev`, so repeated there.
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "RegistryDO" }] },
  // No sender or destination restriction: the sender is the secret EMAIL_FROM, the destination the caller's contact.
  "send_email": [{ "name": "EMAIL" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryDO"] }],
  // Workers Rate Limiting (config only, nothing to create; each is optional in the code). CODE_LIMIT: per caller IP, on
  // every /v1/instances route (src/instances.ts). The rest are RFC 0015 section 3 (src/v1.ts): HANDLE_LIMIT per caller
  // IP on /v1/handles; HEALTH_LIMIT per caller IP on the signed deep health; SEND_LIMIT and CALL_LIMIT per instance id
  // (decision D4); PHONE_LIMIT per phone (the tag).
  "ratelimits": [
    { "name": "CODE_LIMIT", "namespace_id": "4201", "simple": { "limit": 5, "period": 60 } },
    { "name": "HANDLE_LIMIT", "namespace_id": "4211", "simple": { "limit": 60, "period": 60 } },
    { "name": "HEALTH_LIMIT", "namespace_id": "4251", "simple": { "limit": 120, "period": 60 } },
    { "name": "SEND_LIMIT", "namespace_id": "4221", "simple": { "limit": 600, "period": 60 } },
    { "name": "CALL_LIMIT", "namespace_id": "4231", "simple": { "limit": 60, "period": 60 } },
    { "name": "PHONE_LIMIT", "namespace_id": "4241", "simple": { "limit": 30, "period": 60 } },
  ],
  // Set with `wrangler secret put` from files outside the repository; never in this file. `FCM_SERVICE_ACCOUNT` (the
  // Google service account's JSON key, for Android) is optional: without it the relay serves iPhones only (README).
  // `RELAY_HANDLE_KEYS` (the handle keyring) and `RELAY_TAG_KEY` (RFC 0015 section 2) are optional too: without them
  // `/v1/handles` and `/v1/send` answer 503 not_configured and `/send` keeps working (README "Handles and /v1/send").
  "secrets": { "required": ["APNS_KEY", "APNS_KEY_ID", "APNS_TEAM_ID", "RELAY_SEND_TOKEN"] },
  "env": {
    "dev": {
      // `brigade-relay-dev` on workers.dev, for the spike. Every send needs the bearer token.
      "workers_dev": true,
      // Development builds (Xcode, the Simulator) get sandbox device tokens.
      "vars": {
        "APNS_ENVIRONMENT": "sandbox",
        "APNS_TOPIC": "app.freecorps.brigade",
        "RELAY_TERMS_VERSION": "draft-2026-11",
      },
      "secrets": { "required": ["APNS_KEY", "APNS_KEY_ID", "APNS_TEAM_ID", "RELAY_SEND_TOKEN"] },
      "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "RegistryDO" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryDO"] }],
      "ratelimits": [
        { "name": "CODE_LIMIT", "namespace_id": "4202", "simple": { "limit": 5, "period": 60 } },
        { "name": "HANDLE_LIMIT", "namespace_id": "4212", "simple": { "limit": 60, "period": 60 } },
        {
          "name": "HEALTH_LIMIT",
          "namespace_id": "4252",
          "simple": { "limit": 120, "period": 60 },
        },
        { "name": "SEND_LIMIT", "namespace_id": "4222", "simple": { "limit": 600, "period": 60 } },
        { "name": "CALL_LIMIT", "namespace_id": "4232", "simple": { "limit": 60, "period": 60 } },
        { "name": "PHONE_LIMIT", "namespace_id": "4242", "simple": { "limit": 30, "period": 60 } },
      ],
    },
  },
}
