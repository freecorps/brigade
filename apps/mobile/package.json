    "@formatjs/intl-pluralrules": "^6.3.16",
    "@formatjs/intl-relativetimeformat": "^12.3.16",
    "@freecorps/brigade-i18n": "workspace:*",
    "@freecorps/brigade-schema": "workspace:*",
    "@freecorps/brigade-sync": "workspace:*",
    "@freecorps/brigade-ui": "workspace:*",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-reanimated",
