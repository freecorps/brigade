{
  "name": "@freecorps/brigade-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Freecorps Brigade push relay: the Cloudflare Worker that forwards encrypted pushes to APNs (RFC 0006).",
  "license": "AGPL-3.0-only",
  "author": "Freecorps Tecnologia da Informação LTDA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/brigade.git",
    "directory": "apps/relay"
  },
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vp dev",
