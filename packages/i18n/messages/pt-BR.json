{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_name": "Brigade",
  "app_tagline": "Gestão de incidentes open source que roda na sua conta da Cloudflare.",
  "theme_label": "Tema",
  "theme_light": "Claro",
  "theme_dark": "Escuro",
