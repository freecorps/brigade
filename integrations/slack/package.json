{
  "name": "@freecorps/brigade-slack",
  "version": "0.0.0",
  "private": true,
  "description": "Freecorps Brigade's Slack app: the Worker for /inc, the Events API, the Acknowledge button and installation, and the incident messages, channels and timeline mirror the API sends (RFC 0011).",
  "license": "AGPL-3.0-only",
  "author": "Freecorps Tecnologia da Informação LTDA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/brigade.git",
    "directory": "integrations/slack"
  },
  "type": "module",
  "exports": {
    "./bridge": {
      "@freecorps/source": "./src/bridge.ts",
      "default": "./src/bridge.ts"
    },
    "./notifier": {
      "@freecorps/source": "./src/notifier.ts",
      "default": "./src/notifier.ts"
    },
    "./modal": {
      "@freecorps/source": "./src/modal.ts",
      "default": "./src/modal.ts"
    },
    "./people": {
      "@freecorps/source": "./src/people.ts",
      "default": "./src/people.ts"
    },
    "./replies": {
      "@freecorps/source": "./src/replies.ts",
      "default": "./src/replies.ts"
    },
    "./web-api": {
      "@freecorps/source": "./src/web-api.ts",
      "default": "./src/web-api.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vp dev",
    "build": "vp build",
    "test": "wrangler types --check && vp test",
    "check": "vp check",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@freecorps/brigade-i18n": "workspace:*",
    "@freecorps/brigade-schema": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  }
}
