{
  "name": "@freecorps/brigade-status-edge",
  "version": "0.0.0",
  "private": true,
  "description": "Freecorps Brigade's status page edge: the Worker on the Cloudflare for SaaS zone that serves a status page at its own domain through the API (RFC 0012 \"Custom domains\").",
  "license": "AGPL-3.0-only",
  "author": "Freecorps Tecnologia da Informação LTDA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/brigade.git",
    "directory": "apps/status-edge"
  },
  "type": "module",
  "exports": {
    "./api": {
      "@freecorps/source": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vp dev",
    "build": "vp build",
    "build:dev": "CLOUDFLARE_ENV=dev vp build",
    "test": "wrangler types --check && vp test",
    "check": "vp check",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@freecorps/brigade-i18n": "workspace:*",
    "@freecorps/brigade-schema": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "wrangler": "^4.152.0"
  }
}
