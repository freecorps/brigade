{
  "name": "@freecorps/brigade-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Freecorps Brigade mobile app (iOS and Android), built with Expo.",
  "license": "AGPL-3.0-only",
  "author": "Freecorps Tecnologia da Informação LTDA",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freecorps/brigade.git",
    "directory": "apps/mobile"
  },
  "main": "./src/index.ts",
  "scripts": {
    "start": "expo start --dev-client",
