// Spike S1 (RFC 0006). The top-level config is production (`brigade-relay`); `dev` is the environment below.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigade-relay",
  "main": "./src/index.ts",
  // Matches the installed workerd so local and deployed behaviour agree.
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    // No traces: an outbound fetch span records the URL, and the APNs URL ends in the device token.
    "traces": { "enabled": false },
  },
  "upload_source_maps": true,
  // Production APNs; the app's build sets `aps-environment` to match.
  "vars": { "APNS_ENVIRONMENT": "production", "APNS_TOPIC": "app.freecorps.brigade" },
  // Set with `wrangler secret put` from files outside the repository; never in this file.
  "secrets": { "required": ["APNS_KEY", "APNS_KEY_ID", "APNS_TEAM_ID", "RELAY_SEND_TOKEN"] },
  "env": {
    "dev": {
      // `brigade-relay-dev` on workers.dev, for the spike. Every send needs the bearer token.
      "workers_dev": true,
      // Development builds (Xcode, the Simulator) get sandbox device tokens.
      "vars": { "APNS_ENVIRONMENT": "sandbox", "APNS_TOPIC": "app.freecorps.brigade" },
      "secrets": { "required": ["APNS_KEY", "APNS_KEY_ID", "APNS_TEAM_ID", "RELAY_SEND_TOKEN"] },
    },
  },
}
