{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_name": "Brigade",
  "app_tagline": "Gestão de incidentes open source que roda na sua conta da Cloudflare.",
  "theme_label": "Tema",
  "theme_light": "Claro",
  "theme_dark": "Escuro",
  "theme_system": "Sistema",
  "language_label": "Idioma",
  "severity_sev1": "Crítica",
  "severity_sev2": "Alta",
  "severity_sev3": "Média",
  "severity_sev4": "Baixa",
  "incident_status_triage": "Triagem",
  "incident_status_investigating": "Investigando",
  "incident_status_fixing": "Corrigindo",
  "incident_status_monitoring": "Monitorando",
  "incident_status_resolved": "Resolvido",
  "incident_status_declined": "Descartado",
  "incidents_active_count": [
    {
      "declarations": [
        "input count",
        "local countExact = count",
        "local countPlural = count: plural",
        "local countFormatted = count: number"
      ],
      "selectors": ["countExact", "countPlural"],
      "match": {
        "countExact=0, countPlural=*": "Nenhum incidente ativo",
        "countExact=*, countPlural=one": "{countFormatted} incidente ativo",
        "countExact=*, countPlural=*": "{countFormatted} incidentes ativos"
      }
    }
  ]
}
