  "monitors_count": [
    {
      "declarations": [
        "input count",
        "local countExact = count",
        "local countPlural = count: plural",
        "local countFormatted = count: number"
      ],
      "selectors": ["countExact", "countPlural"],
      "match": {
        "countExact=0, countPlural=*": "No monitors",
        "countExact=*, countPlural=one": "{countFormatted} monitor",
        "countExact=*, countPlural=*": "{countFormatted} monitors"
      }
    }
  ],
  "monitors_down_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural",
        "local countFormatted = count: number"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{countFormatted} down",
        "countPlural=*": "{countFormatted} down"
      }
    }
  ],
  "monitors_empty": "Nothing is watched yet. Add an HTTP check, or a heartbeat for jobs that should check in.",
  "monitor_add": "Add monitor",
  "monitor_kind": [
    {
      "declarations": ["input kind"],
      "selectors": ["kind"],
      "match": {
        "kind=http": "HTTP check",
        "kind=*": "Heartbeat"
      }
    }
  ],
  "monitor_status": [
    {
      "declarations": ["input status"],
      "selectors": ["status"],
      "match": {
        "status=up": "Up",
        "status=down": "Down",
        "status=paused": "Paused",
        "status=unknown": "No data",
        "status=*": "Waiting"
      }
